{
    "projectId": "69a6d89d0007909f06f7",
    "projectName": "pointchat",
    "functions": [
        {
            "$id": "media_cleanup",
            "name": "Media Cleanup",
            "runtime": "node-18.0",
            "path": "appwrite_functions/delete_old_media",
            "entrypoint": "index.js",
            "commands": "npm install",
            "scopes": [
                "documents.read",
                "documents.write",
                "files.read",
                "files.write"
            ]
        },
        {
            "$id": "chat_ai",
            "name": "Chat AI",
            "runtime": "node-18.0",
            "path": "appwrite_functions/chat_ai",
            "entrypoint": "index.js",
            "commands": "npm install",
            "execute": [
                "users"
            ]
        },
        {
            "$id": "account_deletion",
            "name": "Account Deletion",
            "runtime": "node-18.0",
            "path": "appwrite_functions/account_deletion",
            "entrypoint": "index.js",
            "commands": "npm install",
            "scopes": [
                "users.read",
                "users.write"
            ],
            "execute": [
                "users"
            ]
        }
    ],
    "sites": [
        {
            "$id": "account-deletion-site",
            "name": "PointChat Account Deletion",
            "path": "appwrite_sites/account_deletion",
            "framework": "other",
            "enabled": true,
            "logging": true,
            "timeout": 15,
            "buildRuntime": "node-22",
            "adapter": "static",
            "installCommand": "",
            "buildCommand": ":",
            "outputDirectory": "./",
            "fallbackFile": ""
        }
    ]
}