opt_out_usage

require 'dotenv'
Dotenv.load('.env')
Dotenv.load(File.expand_path('~/.mobile_deploy_keys/credentials.env'))

default_platform(:ios)

# Helper health checks
def check_ios_health
  UI.message("📱 Checking iOS prerequisites...")
  key_filepath = ENV['APP_STORE_CONNECT_API_KEY_KEY_FILEPATH'] || File.expand_path('~/.mobile_deploy_keys/AuthKey_J34F5SH629.p8')
  if File.exist?(key_filepath)
    UI.success("  ✓ Apple API Key found at #{key_filepath}")
  else
    UI.error("  ✗ Apple API Key NOT found at #{key_filepath}")
  end
end

def check_android_health
  UI.message("🤖 Checking Android prerequisites...")
  json_key = ENV['SUPPLY_JSON_KEY'] || File.expand_path('~/.mobile_deploy_keys/google-play-api-key.json')
  if File.exist?(json_key)
    UI.success("  ✓ Google Play Service Account JSON found at #{json_key}")
  else
    UI.important("  ℹ️ Google Play JSON not found at #{json_key} (Place in ~/.mobile_deploy_keys/ to enable Play Store uploads)")
  end

  keystore = ENV['ANDROID_KEYSTORE_PATH'] || File.expand_path('~/.mobile_deploy_keys/my-upload-key.jks')
  if File.exist?(keystore)
    UI.success("  ✓ Android keystore found at #{keystore}")
  else
    UI.important("  ℹ️ Android keystore not found at #{keystore}")
  end
end

desc "Run pre-flight health check on all mobile credentials & toolchains"
lane :doctor do
  UI.header("🔍 Running Mobile Deployment Health Check")
  check_ios_health
  check_android_health
  UI.success("🎉 Pre-flight health check complete!")
end

desc "Deploy both iOS (TestFlight) and Android (Internal Track)"
lane :deploy_all do |options|
  track = options[:track] || 'internal'
  UI.header("🚀 Starting Full Deployment (iOS TestFlight + Android #{track.upcase})")
  
  if options[:bump]
    bump_version(type: options[:bump])
  end

  android_lane = track == 'production' ? 'production' : (track == 'beta' ? 'beta' : 'internal')
  Fastlane::LaneManager.cruise_lane('android', android_lane)
  Fastlane::LaneManager.cruise_lane('ios', 'beta')

  UI.success("🎉 Full deployment finished successfully!")
end

desc "Bump version in pubspec.yaml (e.g. fastlane bump_version type:patch|minor|major|build)"
lane :bump_version do |options|
  type = options[:type] || 'build'
  pubspec_path = File.expand_path('../pubspec.yaml', __dir__)
  if File.exist?(pubspec_path)
    content = File.read(pubspec_path)
    if content =~ /^version:\s*(\d+)\.(\d+)\.(\d+)\+(\d+)/
      major = $1.to_i
      minor = $2.to_i
      patch = $3.to_i
      build = $4.to_i

      case type.to_s.downcase
      when 'major'
        major += 1
        minor = 0
        patch = 0
        build += 1
      when 'minor'
        minor += 1
        patch = 0
        build += 1
      when 'patch'
        patch += 1
        build += 1
      else
        build += 1
      end

      new_version = "#{major}.#{minor}.#{patch}+#{build}"
      new_content = content.gsub(/^version:\s*.*$/, "version: #{new_version}")
      File.write(pubspec_path, new_content)
      UI.success("✅ Bumped pubspec.yaml version to #{new_version}")
    else
      UI.important("⚠️ Could not parse version in pubspec.yaml. Skipping auto-bump.")
    end
  end
end

platform :ios do
  before_all do
    key_id = ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'] || 'J34F5SH629'
    issuer_id = ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID']
    key_filepath = ENV['APP_STORE_CONNECT_API_KEY_KEY_FILEPATH'] || File.expand_path('~/.mobile_deploy_keys/AuthKey_J34F5SH629.p8')

    if File.exist?(key_filepath) && issuer_id && !issuer_id.empty? && !issuer_id.include?('INSERT_YOUR')
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_filepath,
        in_house: false
      )
    else
      UI.important("⚠️ App Store Connect API Key (Issuer ID) not set in credentials.env. Manual / session auth will be used if needed.")
    end
  end

  desc "Verify iOS signing, tools, and credentials"
  lane :doctor do
    check_ios_health
  end

  desc "Build Flutter iOS and upload to TestFlight"
  lane :beta do |options|
    UI.header("🍏 Building & Uploading iOS App to TestFlight")
    changelog = options[:changelog] || options[:notes] || "Automated update #{Time.now.strftime('%Y-%m-%d %H:%M')}"

    sh("cd ../ && flutter build ipa --release")

    ipa_path = Dir.glob(File.expand_path('../build/ios/ipa/*.ipa', __dir__)).first
    unless ipa_path && File.exist?(ipa_path)
      UI.user_error!("Could not find built IPA in build/ios/ipa/")
    end

    UI.message("📦 Found IPA at #{ipa_path}. Uploading to TestFlight...")

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
      distribute_external: options[:distribute_external] || false
    )

    UI.success("🎉 Successfully uploaded IPA to TestFlight!")
  end

  desc "Build Flutter iOS and submit to App Store"
  lane :release do |options|
    UI.header("🍏 Building & Submitting iOS App to App Store")

    sh("cd ../ && flutter build ipa --release")

    ipa_path = Dir.glob(File.expand_path('../build/ios/ipa/*.ipa', __dir__)).first
    unless ipa_path && File.exist?(ipa_path)
      UI.user_error!("Could not find built IPA in build/ios/ipa/")
    end

    upload_to_app_store(
      ipa: ipa_path,
      force: true,
      skip_waiting_for_build_processing: true,
      submit_for_review: options[:submit_for_review] || false,
      automatic_release: true
    )

    UI.success("🎉 Successfully uploaded IPA to App Store!")
  end
end

platform :android do
  desc "Verify Android signing, tools, and credentials"
  lane :doctor do
    check_android_health
  end

  desc "Build Flutter Android App Bundle and upload to Google Play Internal Track"
  lane :internal do |options|
    deploy_android_track('internal', options)
  end

  desc "Build Flutter Android App Bundle and upload to Google Play Beta Track"
  lane :beta do |options|
    deploy_android_track('beta', options)
  end

  desc "Build Flutter Android App Bundle and upload to Google Play Production Track"
  lane :production do |options|
    deploy_android_track('production', options)
  end

  def deploy_android_track(track_name, options)
    UI.header("🤖 Building & Deploying Android AAB to #{track_name.upcase} track")

    sh("cd ../ && flutter build appbundle --release")

    aab_path = Dir.glob(File.expand_path('../build/app/outputs/bundle/release/*.aab', __dir__)).first
    unless aab_path && File.exist?(aab_path)
      UI.user_error!("Could not find built AAB in build/app/outputs/bundle/release/")
    end

    UI.message("📦 Found AAB at #{aab_path}. Uploading to Google Play (#{track_name})...")

    json_key = ENV['SUPPLY_JSON_KEY'] || File.expand_path('~/.mobile_deploy_keys/google-play-api-key.json')
    unless File.exist?(json_key)
      UI.user_error!("Google Play JSON Key file not found at #{json_key}. Please place your service account json in ~/.mobile_deploy_keys/google-play-api-key.json")
    end

    upload_to_play_store(
      track: track_name,
      aab: aab_path,
      json_key: json_key,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_metadata: options[:update_metadata] ? false : true,
      skip_upload_changelogs: options[:update_changelogs] ? false : true
    )

    UI.success("🎉 Successfully deployed Android App Bundle to Google Play (#{track_name})!")
  end
end
