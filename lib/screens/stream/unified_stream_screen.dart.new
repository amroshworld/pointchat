import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:intl/intl.dart';
import '../../services/chat_service.dart';
import '../../services/user_service.dart';
import '../../models/chat_model.dart';
import '../../models/user_model.dart';
import '../../models/message_model.dart';

class UnifiedStreamScreen extends StatefulWidget {
  const UnifiedStreamScreen({super.key});

  @override
  State<UnifiedStreamScreen> createState() => _UnifiedStreamScreenState();
}

class _UnifiedStreamScreenState extends State<UnifiedStreamScreen> {
  final TextEditingController _commandController = TextEditingController();
  final FocusNode _commandFocusNode = FocusNode();
  
  final _chatService = ChatService();
  final _userService = UserService();
  final currentUserId = FirebaseAuth.instance.currentUser!.uid;

  List<UserModel> _allUsers = [];

  Map<String, dynamic>? _peekingItem;
  List<MessageModel> _peekingMessages = [];

  @override
  void initState() {
    super.initState();
    // Pre-cache all users so we can resolve '@username' instantly
    _userService.getAllUsers(currentUserId).listen((users) {
      if (mounted) {
        setState(() {
          _allUsers = users;
        });
      }
    });
  }

  @override
  void dispose() {
    _commandController.dispose();
    _commandFocusNode.dispose();
    super.dispose();
  }

  String _formatHandle(String name) {
    return '@${name.replaceAll(' ', '').toLowerCase()}';
  }

  void _handleItemTap(String handle) {
    // Insert handle into command bar
    _commandController.text = '$handle ';
    _commandController.selection = TextSelection.fromPosition(
      TextPosition(offset: _commandController.text.length),
    );
    _commandFocusNode.requestFocus();
  }

  void _handleLongPress(Map<String, dynamic> item) async {
    setState(() {
      _peekingItem = item;
      _peekingMessages = [];
    });

    if (item['chatId'] != null) {
      // Load last 3 messages
      final messages = await _chatService.getChatMessages(item['chatId']).first;
      if (mounted) {
        setState(() {
          _peekingMessages = messages.take(3).toList();
        });
      }
    }
  }

  void _closePeek() {
    setState(() {
      _peekingItem = null;
    });
  }

  void _sendCommand(String input) async {
    final text = input.trim();
    if (text.isEmpty) return;

    if (text.startsWith('@')) {
      final firstSpace = text.indexOf(' ');
      if (firstSpace > 1) {
        final handle = text.substring(1, firstSpace).toLowerCase();
        final msg = text.substring(firstSpace + 1).trim();

        if (msg.isNotEmpty) {
          // Find user by handle
          final targetUser = _allUsers.cast<UserModel?>().firstWhere(
            (u) => u!.displayName.replaceAll(' ', '').toLowerCase() == handle,
            orElse: () => null,
          );

          if (targetUser != null) {
             final chatId = await _chatService.getOrCreateChat(currentUserId, targetUser.uid);
             await _chatService.sendMessage(
                 chatId: chatId,
                 senderId: currentUserId,
                 senderName: FirebaseAuth.instance.currentUser?.displayName ?? 'Me',
                 senderPhotoUrl: FirebaseAuth.instance.currentUser?.photoURL ?? '',
                 text: msg,
             );
             _commandController.clear();
             return;
          } else {
             ScaffoldMessenger.of(context).showSnackBar(
               SnackBar(content: Text('Target $handle not found in network.', style: GoogleFonts.jetBrainsMono()), backgroundColor: Colors.black, shape: Border.all(color: Colors.white)),
             );
             return;
          }
        }
      }
    }

    // Default broadcast or group not handled in this snippet fully
    // We could fallback to sending to an "echo" bot or showing error
    ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Use format: @handle message...', style: GoogleFonts.jetBrainsMono()), backgroundColor: Colors.black, shape: Border.all(color: Colors.white)),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      drawer: FilterDrawer(
        users: _allUsers,
        onUserTap: (user) {
          Navigator.pop(context); // close drawer
          _handleItemTap(_formatHandle(user.displayName));
        },
      ),
      body: Stack(
        children: [
          SafeArea(
            child: Column(
              children: [
                _buildStatusBar(),
                Expanded(
                  child: _buildStreamList(),
                ),
                _buildCommandBar(),
              ],
            ),
          ),
          if (_peekingItem != null) _buildContextPeekOverlay(),
        ],
      ),
    );
  }

  Widget _buildStatusBar() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      decoration: const BoxDecoration(
        border: Border(bottom: BorderSide(color: Colors.white12, width: 1)),
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Expanded(
            child: Text(
              '// UNIFIED STREAM',
              style: GoogleFonts.jetBrainsMono(
                color: Colors.white,
                fontSize: 12,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
          Builder(
            builder: (context) => IconButton(
              icon: const Icon(Icons.people_alt, color: Colors.white, size: 20),
              onPressed: () => Scaffold.of(context).openDrawer(),
              padding: EdgeInsets.zero,
              constraints: const BoxConstraints(),
            ),
          ),
          IconButton(
             icon: const Icon(Icons.logout, color: Colors.white, size: 20),
             onPressed: () => FirebaseAuth.instance.signOut(),
             padding: EdgeInsets.zero,
             constraints: const BoxConstraints(),
          ),
        ],
      ),
    );
  }

  Widget _buildStreamList() {
    return StreamBuilder<List<ChatModel>>(
      stream: _chatService.getUserChats(currentUserId),
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return Center(
            child: Text('AWAITING SIGNAL...', style: GoogleFonts.spaceMono(color: Colors.white54, fontSize: 32)),
          );
        }

        final chats = snapshot.data ?? [];
        if (chats.isEmpty) {
          return Center(
            child: Text('NO SIGNAL', style: GoogleFonts.spaceMono(color: Colors.white54, fontSize: 32, letterSpacing: -1)),
          );
        }

        return ListView.builder(
          reverse: false,
          physics: const BouncingScrollPhysics(),
          itemCount: chats.length + 1, // +1 for date separator
          itemBuilder: (context, index) {
            if (index == 0) {
              return const DateSeparator(dateText: 'TODAY');
            }
            final chat = chats[index - 1];
            final otherUserId = chat.getOtherUserId(currentUserId);
            // find user
            final otherUser = _allUsers.cast<UserModel?>().firstWhere(
              (u) => u?.uid == otherUserId, 
              orElse: () => null
            );

            final handle = otherUser != null 
                ? _formatHandle(otherUser.displayName) 
                : '@unknown';
                
            String timeStr = '';
            if (chat.lastMessageTime != null) {
               timeStr = DateFormat('HH:mm').format(chat.lastMessageTime!);
            }
            
            final isUnread = (chat.unreadCount[currentUserId] ?? 0) > 0;

            final item = {
              'type': 'dm',
              'handle': handle,
              'content': chat.lastMessage.isEmpty ? 'No messages yet.' : chat.lastMessage,
              'time': timeStr,
              'chatId': chat.chatId,
              'targetUid': otherUserId,
              'isUnread': isUnread
            };

            return StreamItemWidget(
              item: item,
              onTap: () => _handleItemTap(item['handle'] ?? ''),
              onLongPress: () => _handleLongPress(item),
            );
          },
        );
      }
    );
  }

  Widget _buildCommandBar() {
    return Container(
      width: double.infinity,
      height: 64,
      decoration: const BoxDecoration(
        color: Colors.black,
        border: Border(top: BorderSide(color: Colors.white, width: 2)),
      ),
      child: Row(
        children: [
          Padding(
            padding: const EdgeInsets.only(left: 16, right: 8),
            child: Text(
              '>',
              style: GoogleFonts.jetBrainsMono(
                color: Colors.white,
                fontSize: 18,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
          Expanded(
            child: TextField(
              controller: _commandController,
              focusNode: _commandFocusNode,
              style: GoogleFonts.jetBrainsMono(
                color: Colors.white,
                fontSize: 16,
              ),
              decoration: InputDecoration(
                hintText: 'Type @person or #group...',
                hintStyle: GoogleFonts.jetBrainsMono(
                  color: const Color(0xFF444444),
                  fontSize: 16,
                ),
                border: InputBorder.none,
                enabledBorder: InputBorder.none,
                focusedBorder: InputBorder.none,
                contentPadding: EdgeInsets.zero,
                fillColor: Colors.transparent,
              ),
              cursorColor: const Color(0xFF00FF00),
              onSubmitted: _sendCommand,
            ),
          ),
          IconButton(
            icon: const Icon(Icons.arrow_forward, color: Colors.white),
            onPressed: () => _sendCommand(_commandController.text),
          ),
        ],
      ),
    );
  }

  Widget _buildContextPeekOverlay() {
    return GestureDetector(
      onTap: _closePeek,
      child: Container(
        color: Colors.black.withOpacity(0.9),
        width: double.infinity,
        height: double.infinity,
        padding: const EdgeInsets.all(24),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // History
            if (_peekingMessages.isNotEmpty)
              ..._peekingMessages.reversed.skip(1).map((msg) => 
                Padding(
                  padding: const EdgeInsets.only(bottom: 8.0),
                  child: Opacity(
                    opacity: 0.5,
                    child: Text(
                      '${msg.senderName} - ${msg.text}',
                      style: GoogleFonts.spaceGrotesk(color: Colors.white, fontSize: 14),
                    ),
                  ),
                )
              ),
            
            const SizedBox(height: 16),
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                border: Border.all(color: Colors.white, width: 1),
                color: Colors.black,
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                   Text(
                    _peekingItem!['handle'] ?? 'SYSTEM',
                    style: GoogleFonts.spaceMono(
                      color: Colors.white,
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    _peekingItem!['content'] ?? '',
                    style: GoogleFonts.spaceGrotesk(
                      color: Colors.white,
                      fontSize: 18,
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 24),
            Row(
              children: [
                Text(
                  '> to: ${_peekingItem!['handle']} ',
                  style: GoogleFonts.jetBrainsMono(
                    color: const Color(0xFF00FF00),
                    fontSize: 16,
                  ),
                ),
                Expanded(
                  child: TextField(
                    autofocus: true,
                    style: GoogleFonts.jetBrainsMono(
                      color: Colors.white,
                      fontSize: 16,
                    ),
                    decoration: const InputDecoration(
                      border: InputBorder.none,
                      enabledBorder: InputBorder.none,
                      focusedBorder: InputBorder.none,
                      contentPadding: EdgeInsets.zero,
                      fillColor: Colors.transparent,
                    ),
                    cursorColor: const Color(0xFF00FF00),
                    onSubmitted: (val) async {
                      if (val.trim().isNotEmpty) {
                         final chatId = _peekingItem!['chatId'];
                         if (chatId != null) {
                             await _chatService.sendMessage(
                               chatId: chatId,
                               senderId: currentUserId,
                               senderName: FirebaseAuth.instance.currentUser?.displayName ?? 'Me',
                               senderPhotoUrl: '',
                               text: val.trim(),
                             );
                         }
                      }
                      _closePeek();
                    },
                  ),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}

class DateSeparator extends StatelessWidget {
  final String dateText;
  const DateSeparator({super.key, required this.dateText});

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 24),
      child: Center(
        child: Text(
          '-------- [ $dateText ] --------',
          style: GoogleFonts.jetBrainsMono(
            color: const Color(0xFF666666),
            fontSize: 12,
            letterSpacing: 2,
          ),
          maxLines: 1,
          overflow: TextOverflow.clip,
        ),
      ),
    );
  }
}

class StreamItemWidget extends StatelessWidget {
  final Map<String, dynamic> item;
  final VoidCallback onTap;
  final VoidCallback onLongPress;

  const StreamItemWidget({
    super.key,
    required this.item,
    required this.onTap,
    required this.onLongPress,
  });

  @override
  Widget build(BuildContext context) {
    final type = item['type'];
    final isUnread = item['isUnread'] ?? false;
    
    return InkWell(
      onTap: onTap,
      onLongPress: onLongPress,
      splashColor: Colors.white24,
      child: Container(
        color: isUnread ? Colors.white12 : Colors.transparent,
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 12),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // Avatar Placeholder (Dithered Box)
            Container(
              width: 32,
              height: 32,
              color: isUnread ? const Color(0xFF00FF00) : Colors.white,
              child: Center(
                child: Text(
                  (item['handle'] ?? '?').replaceAll('@', '').substring(0, 1).toUpperCase(),
                  style: GoogleFonts.spaceMono(
                    color: Colors.black,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Text(
                        item['handle'] ?? '',
                        style: GoogleFonts.spaceMono(
                          color: Colors.white,
                          fontSize: 16,
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                      Text(
                        item['time'] ?? '',
                        style: GoogleFonts.jetBrainsMono(
                          color: const Color(0xFF666666),
                          fontSize: 12,
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 4),
                  if (type == 'group')
                    Text(
                      '[${item['sender']}]: ${item['content']}',
                      style: GoogleFonts.spaceGrotesk(
                        color: Colors.white,
                        fontSize: 16,
                        height: 1.4,
                      ),
                    )
                  else
                    Text(
                      item['content'] ?? '',
                      style: GoogleFonts.spaceGrotesk(
                        color: Colors.white, // isUnread ? Colors.white : Colors.white70
                        fontSize: 16,
                        height: 1.4,
                      ),
                    ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class FilterDrawer extends StatelessWidget {
  final List<UserModel> users;
  final Function(UserModel) onUserTap;

  const FilterDrawer({super.key, required this.users, required this.onUserTap});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: MediaQuery.of(context).size.width * 0.8,
      decoration: const BoxDecoration(
        color: Colors.black,
        border: Border(right: BorderSide(color: Colors.white, width: 1)),
      ),
      child: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                '// NETWORK (PEOPLE)',
                style: GoogleFonts.spaceMono(
                  color: Colors.white,
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 32),
              Row(
                children: [
                  Text(
                    '[ ONLINE ]',
                    style: GoogleFonts.jetBrainsMono(
                      color: Colors.white,
                      fontSize: 14,
                      decoration: TextDecoration.underline,
                    ),
                  ),
                  const SizedBox(width: 16),
                  Text(
                    '[ ALL ]',
                    style: GoogleFonts.jetBrainsMono(
                      color: const Color(0xFF666666),
                      fontSize: 14,
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 32),
              Expanded(
                child: users.isEmpty 
                 ? Text("NO CONTACTS.", style: GoogleFonts.jetBrainsMono(color: Colors.white54))
                 : ListView(
                  children: users.map((u) => _buildUserItem(u)).toList(),
                ),
              ),
              SizedBox(
                width: double.infinity,
                child: OutlinedButton(
                  onPressed: () => Navigator.pop(context),
                  style: OutlinedButton.styleFrom(
                    side: const BorderSide(color: Colors.white, width: 2),
                    padding: const EdgeInsets.symmetric(vertical: 16),
                    shape: const RoundedRectangleBorder(borderRadius: BorderRadius.zero),
                  ),
                  child: Text(
                    '[ CLOSE TERMINAL ]',
                    style: GoogleFonts.jetBrainsMono(
                      color: Colors.white,
                      fontSize: 14,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildUserItem(UserModel user) {
    final handle = '@${user.displayName.replaceAll(' ', '').toLowerCase()}';
    
    return InkWell(
      onTap: () => onUserTap(user),
      child: Padding(
        padding: const EdgeInsets.symmetric(vertical: 16),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Row(
              children: [
                Icon(Icons.person, color: Colors.white54, size: 16),
                const SizedBox(width: 8),
                Text(
                  handle,
                  style: GoogleFonts.spaceMono(
                    color: Colors.white,
                    fontSize: 18,
                  ),
                ),
              ],
            ),
            if (user.isOnline)
               Container(width: 8, height: 8, color: const Color(0xFF00FF00))
          ],
        ),
      ),
    );
  }
}
